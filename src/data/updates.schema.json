{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stormlog 'What's New' content",
  "description": "Source of truth for the landing page's What's New section and popup. Generated by scripts/generate-updates.mjs from stormlog release notes, then reviewed via PR before merging.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "releasedAt", "whatsNewKey", "meta", "updates"],
  "properties": {
    "$schema": { "type": "string" },
    "version": {
      "type": "string",
      "description": "Stormlog package version this content was authored for (e.g. '0.3.6'). Used as a sanity check against PyPI.",
      "pattern": "^\\d+\\.\\d+\\.\\d+([.\\-+][0-9A-Za-z.\\-+]*)?$"
    },
    "releasedAt": {
      "type": "string",
      "description": "ISO-8601 date (YYYY-MM-DD) the release was published.",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "whatsNewKey": {
      "type": "string",
      "description": "Stable cache key for the 'What's new' popup. Bump on every release so returning visitors see the dialog once for the new content. Convention: 'YYYY-MM-headline-slug'.",
      "pattern": "^[a-z0-9-]+$"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "title", "description"],
      "properties": {
        "eyebrow": { "type": "string", "maxLength": 32 },
        "title": { "type": "string", "maxLength": 72 },
        "description": { "type": "string", "maxLength": 320 }
      }
    },
    "updates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kicker",
          "title",
          "summary",
          "highlights",
          "command",
          "codeLabel",
          "code",
          "href"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "kicker": { "type": "string", "maxLength": 28 },
          "title": { "type": "string", "maxLength": 80 },
          "summary": { "type": "string", "maxLength": 320 },
          "highlights": {
            "type": "array",
            "minItems": 2,
            "maxItems": 6,
            "items": { "type": "string", "maxLength": 200 }
          },
          "command": { "type": "string", "maxLength": 200 },
          "codeLabel": { "type": "string", "enum": ["python", "bash", "shell", "json", "yaml"] },
          "code": { "type": "string", "maxLength": 800 },
          "href": { "type": "string", "pattern": "^#" },
          "externalLink": { "type": "string", "format": "uri" }
        }
      }
    }
  }
}
